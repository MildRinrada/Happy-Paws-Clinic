# Copy to .env.local (Next.js reads it from this folder, not from the repository root).

# Server-side only — server components, server actions and route handlers call the API here and
# attach the session's bearer token. The contract's base URL ends in /v1.
API_BASE_URL=http://localhost:5080/v1

# Browser-visible; reserved for the contract's public reads.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5080/v1
