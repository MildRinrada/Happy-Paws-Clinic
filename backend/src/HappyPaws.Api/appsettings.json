{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": ""
  },
  "Clinic": {
    "TimeZone": "Asia/Bangkok",
    "DefaultCulture": "th-TH"
  },
  "Auth": {
    "Jwt": {
      "Issuer": "",
