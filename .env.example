# Copy to .env and fill in. Never commit the filled-in file.

# ---- database ----
POSTGRES_DB=happypaws
POSTGRES_USER=happypaws
# Matches the connection string in backend/src/HappyPaws.Api/appsettings.Development.json.
# Local development only: use a real secret anywhere else.
POSTGRES_PASSWORD=happypaws
# Host port for the database container. Pick another (e.g. 5433) if a local PostgreSQL already
# owns 5432, and point ConnectionStrings__Postgres at it when running the API outside Docker.
POSTGRES_PORT=5432

# ---- api ----
ASPNETCORE_ENVIRONMENT=Development

# ---- frontend ----
# Server-side (server components, route handlers) — may point at an internal host.
API_BASE_URL=http://localhost:5080/v1
# Browser-visible; used only for the contract's public reads.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5080/v1
# The public website's own address, no trailing slash (canonical links, sitemap, link previews).
# Baked into the web image at build time: rebuild the image after changing it.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- LINE Messaging (outbound notifications only — not login, not account linking) ----
# This clinic's own Official Account channel, not a shared platform account.
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
